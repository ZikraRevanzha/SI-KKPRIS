# ============================================================================
# Konfigurasi Environment SI-KKPRIS (Koperasi KKPRIS SMKN 1 Kota Solok)
# ============================================================================
DEBUG=True
SECRET_KEY=django-insecure-si-kkpris-smkn1-solok-dev-key-2026
ALLOWED_HOSTS=127.0.0.1,localhost

# Keamanan produksi (aktif otomatis saat DEBUG=False; atur eksplisit bila perlu)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
TRUSTED_PROXY=False

# Konfigurasi Database MySQL 8.0+ (Laragon MySQL 8.4)
DB_ENGINE=django.db.backends.mysql
DB_NAME=si_kkpris
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Aturan bisnis sementara (lihat PENDING_KONFIRMASI.md)
MARGIN_PERSEN_SEMENTARA=1.00  # PENDING PND-01 — nilai contoh, BUKAN ketetapan koperasi

# Password akun dummy untuk python manage.py seed_master (wajib diisi di .env lokal)
SEED_PASSWORD=ganti-password-seed-lokal

